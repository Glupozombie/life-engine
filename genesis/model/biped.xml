<mujoco model="genesis_planar_biped">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.005" gravity="0 0 -9.81" integrator="implicitfast" cone="elliptic"/>
  <size njmax="300" nconmax="80"/>
  <default>
    <joint damping="1.2" armature="0.015" limited="true"/>
    <geom condim="3" friction="1.0 0.1 0.1" density="650" solref="0.01 1" solimp="0.9 0.95 0.001"/>
    <motor ctrllimited="true" ctrlrange="-1 1" gear="65"/>
  </default>
  <worldbody>
    <light pos="0 -3 5" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="20 2 0.1" rgba="0.13 0.17 0.21 1"/>
    <body name="pelvis" pos="0 0 0.78">
      <joint name="root_x" type="slide" axis="1 0 0" limited="false"/>
      <joint name="root_z" type="slide" axis="0 0 1" limited="false"/>
      <joint name="root_pitch" type="hinge" axis="0 1 0" range="-3.14 3.14"/>
      <inertial pos="0 0 0" mass="8" diaginertia="0.12 0.12 0.08"/>
      <geom name="pelvis_geom" type="box" pos="0 0 0" size="0.13 0.09 0.10" rgba="0.2 0.65 0.72 1"/>
      <body name="torso" pos="0 0 0.08">
        <joint name="spine" type="hinge" axis="0 1 0" range="-0.7 0.7"/>
        <geom type="capsule" fromto="0 0 0 0 0 0.42" size="0.105" mass="5"/>
        <site name="torso_site" pos="0 0 0.2" size="0.02"/>
        <body name="head" pos="0 0 0.48">
          <geom type="sphere" size="0.095" mass="1.2" rgba="0.35 0.72 0.82 1"/>
        </body>
      </body>
      <body name="left_thigh" pos="0 0.075 -0.06">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-1.8 1.8"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.34" size="0.065" mass="3"/>
        <body name="left_shin" pos="0 0 -0.34">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-2.2 0.15"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.32" size="0.045" mass="2"/>
          <body name="left_foot" pos="0.045 0 -0.32">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom name="left_foot_geom" type="box" pos="0.08 0 -0.025" size="0.13 0.055 0.035" mass="0.8"/>
            <site name="left_foot_site" pos="0.08 0 -0.025" size="0.025"/>
          </body>
        </body>
      </body>
      <body name="right_thigh" pos="0 -0.075 -0.06">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-1.8 1.8"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.34" size="0.065" mass="3"/>
        <body name="right_shin" pos="0 0 -0.34">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-2.2 0.15"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.32" size="0.045" mass="2"/>
          <body name="right_foot" pos="0.045 0 -0.32">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-0.8 0.8"/>
            <geom name="right_foot_geom" type="box" pos="0.08 0 -0.025" size="0.13 0.055 0.035" mass="0.8"/>
            <site name="right_foot_site" pos="0.08 0 -0.025" size="0.025"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor joint="spine"/>
    <motor joint="left_hip"/>
    <motor joint="left_knee"/>
    <motor joint="left_ankle"/>
    <motor joint="right_hip"/>
    <motor joint="right_knee"/>
    <motor joint="right_ankle"/>
  </actuator>
  <sensor>
    <framequat name="torso_orientation" objtype="body" objname="torso"/>
    <gyro name="torso_gyro" site="torso_site"/>
    <touch name="left_foot_touch" site="left_foot_site"/>
    <touch name="right_foot_touch" site="right_foot_site"/>
  </sensor>
</mujoco>
